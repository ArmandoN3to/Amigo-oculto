{
  "name": "amigo-oculto-familia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup": "node --conditions=react-server --import tsx scripts/setup.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "setup:email": "node --import tsx scripts/email.mjs --setup",
    "email:check": "node --import tsx scripts/email.mjs --check",
    "email:test": "node --import tsx --use-system-ca scripts/email.mjs --test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
