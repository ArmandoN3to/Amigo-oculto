# npm run setup gera os segredos e a credencial em .env.local.
APP_URL=http://localhost:3000
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Vazio: PostgreSQL embutido em desenvolvimento neste computador.
# Para hospedagem, informe o PostgreSQL gerenciado com SSL conforme o provedor.
DATABASE_URL=
LOCAL_DATABASE_DIR=.data/postgres

# Gmail SMTP: ative a verificação em duas etapas e gere uma senha de app.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME="Amigo Oculto"
